# 服务端地址参考。本分发不内置任何产品服务端地址 —— 下面的键全部默认留空,
# 账号与套餐相关的端点已随厂商 provider 一并移除,因此这里没有对应的键。
# 按需复制到 .env(或未跟踪的 .env.local)并填自建地址。留空即关闭对应功能。
ANET_BASE_URL=
ANET_CDN_BASE_URL=

# 插件图标静态资源基址。留空则不取远端图标,UI 不渲染插件图标。
ANET_PLUGIN_ASSETS_BASE_URL=
# 官方插件清单来源。留空则只用随包 seed,不向任何远端拉取清单。
ANET_OFFICIAL_PLUGIN_MARKETPLACE_SOURCE=

# 导入会话的来源回链 base,不改变 API;保留 /cn/share,不含分享码。
# 修改 API origin 时同步修改此值,或删除此项以自动跟随 API origin;不要赋空值。
ANET_CONVERSATION_SHARE_WEB_URL=
# 远程资源完整覆盖地址,必须包含与运行版本匹配的版本号;删除此项可自动按版本推导。
ANET_REMOTE_ASSET_CDN_BASE_URL=
# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ANET_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ANET_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ANET_DIST_BASE_URL=
